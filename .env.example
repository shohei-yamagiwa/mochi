# Docker Compose loads .env. The standalone Go binary does not load it.
# cp .env.example .env && chmod 600 .env; replace all placeholders.
MOCHI_GITHUB_APP_ID=REPLACE_WITH_NUMERIC_APP_ID
GITHUB_WEBHOOK_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32_OUTPUT
MOCHI_API_TOKEN=REPLACE_WITH_A_DIFFERENT_OPENSSL_RAND_HEX_32_OUTPUT
# Actual line breaks, not literal backslash-n. Keep the single quotes for Compose.
MOCHI_GITHUB_PRIVATE_KEY='-----BEGIN RSA PRIVATE KEY-----
REPLACE_WITH_DOWNLOADED_PRIVATE_KEY_CONTENTS
-----END RSA PRIVATE KEY-----'
DAYTONA_API_KEY=REPLACE_WITH_DAYTONA_API_KEY
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
# Optional: choose a Daytona target near the server, if your account supports it.
# DAYTONA_TARGET=us
# Full four-specialist preset also requires ANTHROPIC_API_KEY and GEMINI_API_KEY.
